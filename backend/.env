# ============================================
# Purrfect Care Backend — Non-Secret Env Vars
# Firebase CLI reads this file and sets these
# as plain environment variables on Cloud Run.
# DO NOT put secrets here.
# ============================================

# --- App ---
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_HOST=0.0.0.0

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://purrfect-care-app.web.app

# --- Google Gemini AI (non-secret model names) ---
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_CHAT_MODEL=models/gemini-2.0-flash

# --- Safepay (sandbox non-secret config) ---
SAFEPAY_PUBLIC_KEY=sec_4b06144f-d8c2-4fe1-b591-7f5f906f4076
SAFEPAY_ENV=sandbox

# --- Email ---
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Firebase ---
FBASE_CREDENTIALS_PATH=./firebase-credentials.json

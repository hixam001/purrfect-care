# ============================================
# Purrfect Care — .gitignore
# ============================================

# --- Environment / Secrets ---
.env
.env.local
backend/.env
backend/.env.local
*.env
!**/.env.example
firebase-credentials.json
google-services.json
GoogleService-Info.plist
service-account*.json
*.pem
*.p12
*.p8
*.mobileprovision

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.coveragerc
.tox/

# --- IDEs ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
logs/

# --- Node (if frontend is added later) ---
node_modules/
.next/
dist/
.nuxt/

# --- Misc ---
*.bak
*.tmp
*.swp

# --- PDFs (academic proposals, downloaded reference PDFs) ---
*.pdf
backend/rag/pdfs/

# --- Docker (not used in Firebase deployment) ---
backend/Dockerfile
backend/.dockerignore

# --- Firebase deploy cache (auto-generated, not needed in git) ---
.firebase/

# --- Frontend build output ---
frontend/dist/
frontend/.vite/

# --- Mobile (Expo / React Native) ---
mobile/node_modules/
mobile/.expo/
mobile/android/build/
mobile/android/app/build/
mobile/android/.gradle/
mobile/android/app/debug.keystore
mobile/ios/
mobile/dist/
mobile/*.jks
mobile/*.keystore
mobile/.claude/

# --- One-off SQL scripts (already applied, not part of schema migration chain) ---
backend/migrations/fix_rag_index.sql
